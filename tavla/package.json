{
    "name": "tavla",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "firebaseFunctions"
    ],
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "dev": "next dev & firebase emulators:start --only auth,firestore,storage --project=ent-tavla-dev",
        "dev:persist": "next dev & yarn emulators",
        "emulators": "firebase emulators:start --only auth,firestore,storage --project=ent-tavla-dev --import=./.db --export-on-exit=./.db",
        "build": "next build",
        "build:prod": "NEXT_PUBLIC_ENV=prod next build",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "next start",
        "generate": "graphql-codegen",
        "lint": "biome check .",
        "format": "biome format .",
        "fix": "biome check --write .",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install --with-deps chromium",
        "build-start": "next build && next start",
        "postinstall": "cd .. && husky install ./.husky",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@entur/alert": "0.22.1",
        "@entur/button": "5.2.1",
        "@entur/chip": "0.13.1",
        "@entur/dropdown": "9.3.1",
        "@entur/expand": "4.1.1",
        "@entur/form": "10.3.1",
        "@entur/icons": "10.1.1",
        "@entur/layout": "5.1.1",
        "@entur/loader": "0.9.1",
        "@entur/menu": "7.4.1",
        "@entur/modal": "2.1.1",
        "@entur/table": "5.2.1",
        "@entur/tokens": "4.3.1",
        "@entur/tooltip": "6.1.1",
        "@entur/typography": "3.2.0",
        "@google-cloud/logging": "12.3.0",
        "@sentry/nextjs": "11.11.0",
        "@types/jsdom": "30.0.0",
        "dompurify": "3.4.17",
        "firebase": "13.2.0",
        "firebase-admin": "14.5.0",
        "firebase-functions": "7.4.0",
        "graphql": "17.1.0",
        "jsdom": "30.1.3",
        "lodash": "4.18.1",
        "nanoid": "6.0.2",
        "next": "16.4.5",
        "posthog-js": "1.447.2",
        "posthog-node": "5.63.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "swr": "2.5.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.5",
        "@graphql-codegen/cli": "7.4.6",
        "@graphql-codegen/import-types-preset": "4.0.1",
        "@graphql-codegen/typed-document-node": "7.2.0",
        "@graphql-codegen/typescript": "6.1.2",
        "@graphql-codegen/typescript-operations": "6.2.0",
        "@playwright/test": "1.65.0",
        "@types/lodash": "4.17.27",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/semver": "7.8.0",
        "autoprefixer": "10.6.2",
        "firebase-tools": "15.35.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "postcss": "8.5.32",
        "tailwindcss": "3.4.19",
        "typescript": "6.0.3",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "packageManager": "yarn@4.10.3",
    "engines": {
        "node": "22.23.4"
    },
    "resolutions": {
        "basic-ftp": "6.2.1",
        "dompurify": "3.4.17",
        "@graphql-tools/utils": "12.0.4"
    }
}
