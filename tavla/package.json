{
    "name": "tavla",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "firebaseFunctions"
    ],
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "dev": "next dev & firebase emulators:start --only auth,firestore,storage --project=ent-tavla-dev",
        "dev:persist": "next dev & yarn emulators",
        "emulators": "firebase emulators:start --only auth,firestore,storage --project=ent-tavla-dev --import=./.db --export-on-exit=./.db",
        "build": "next build",
        "build:prod": "NEXT_PUBLIC_ENV=prod next build",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "next start",
        "generate": "graphql-codegen",
        "lint": "biome check .",
        "format": "biome format .",
        "fix": "biome check --write .",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install --with-deps chromium",
        "build-start": "next build && next start",
        "postinstall": "cd .. && husky install ./.husky",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "dependencies": {
        "@entur/alert": "0.21.1",
        "@entur/button": "5.0.5",
        "@entur/chip": "0.11.5",
        "@entur/dropdown": "9.1.2",
        "@entur/expand": "4.0.5",
        "@entur/form": "10.1.2",
        "@entur/icons": "10.0.4",
        "@entur/layout": "4.0.5",
        "@entur/loader": "0.8.5",
        "@entur/menu": "7.2.1",
        "@entur/modal": "2.0.5",
        "@entur/table": "5.0.5",
        "@entur/tokens": "4.1.1",
        "@entur/tooltip": "6.0.5",
        "@entur/typography": "3.0.5",
        "@google-cloud/logging": "12.0.1",
        "@sentry/nextjs": "10.74.0",
        "@types/jsdom": "30.0.0",
        "dompurify": "3.4.15",
        "firebase": "12.19.0",
        "firebase-admin": "14.4.0",
        "firebase-functions": "7.4.0",
        "graphql": "17.0.2",
        "jsdom": "30.0.1",
        "lodash": "4.18.1",
        "nanoid": "6.0.1",
        "next": "16.3.5",
        "posthog-js": "1.433.5",
        "posthog-node": "5.52.4",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "swr": "2.5.1",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@graphql-codegen/cli": "7.4.1",
        "@graphql-codegen/import-types-preset": "4.0.1",
        "@graphql-codegen/typed-document-node": "7.1.0",
        "@graphql-codegen/typescript": "6.1.0",
        "@graphql-codegen/typescript-operations": "6.1.6",
        "@playwright/test": "1.63.0",
        "@types/lodash": "4.17.25",
        "@types/node": "26.6.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/semver": "7.8.0",
        "autoprefixer": "10.6.1",
        "firebase-tools": "15.30.1",
        "husky": "9.1.7",
        "lint-staged": "17.5.1",
        "postcss": "8.5.28",
        "tailwindcss": "3.4.19",
        "typescript": "6.0.3",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "packageManager": "yarn@4.10.3",
    "engines": {
        "node": "22.13.0"
    },
    "resolutions": {
        "basic-ftp": "5.3.1",
        "minimatch": "9.0.7",
        "dompurify": "3.4.15"
    }
}
